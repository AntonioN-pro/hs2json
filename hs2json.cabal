cabal-version:      3.0
name:               hs2json
version:            0.1.0.0
synopsis:           Biblioteca Haskell para representacao e Pretty Printing de JSON
description:
    Biblioteca em Haskell para manipulacao e formatacao (pretty printing)
    de dados JSON baseada em um tipo abstrato Doc e testada com QuickCheck.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Antonio Neto, Gabriel Mesquita Torres
maintainer:         antonio.melo@stc.ma.gov.br
category:           Text
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:
        SimpleJSON
        PutJSON
        Prettify
        PrettyJSON
        QuickTestes
    build-depends:
        base       >= 4.14 && < 5,
        QuickCheck >= 2.14 && < 3

executable hs2json
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    default-language: Haskell2010
    build-depends:
        base >= 4.14 && < 5,
        hs2json

test-suite hs2json-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    default-language: Haskell2010
    build-depends:
        base       >= 4.14 && < 5,
        hs2json,
        QuickCheck >= 2.14 && < 3
